APP_NAME=GesMA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Développement : SQLite. Production : mysql (voir README)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gesma
# DB_USERNAME=gesma
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Clé partagée avec le site web Mobilier Addict (en-tête X-API-KEY)
# Générer une valeur longue et aléatoire, ex. : php -r "echo bin2hex(random_bytes(32));"
GESMA_WEBSITE_API_KEY=
# Code du magasin qui reçoit les commandes du site si aucun n'est précisé
GESMA_WEBSITE_DEFAULT_STORE=YAM
# Nombre de jours de sauvegardes conservées
GESMA_BACKUP_KEEP_DAYS=14
