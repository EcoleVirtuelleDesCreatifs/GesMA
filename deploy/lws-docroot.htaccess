# .htaccess à placer dans le DOCROOT du domaine (un niveau au-dessus de l'app)
# Ex. : ~/htdocs/gesma.mobilier-addict.com/.htaccess  — l'app étant dans  …/gesma/
# Installation : cp deploy/lws-docroot.htaccess ../.htaccess

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-API-KEY} .
    RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X-API-KEY}]

    # Bloquer les dossiers sensibles
    RewriteRule ^\.(env|git) - [F,L]
    RewriteRule ^gesma/(app|bootstrap|config|database|resources|routes|storage|tests|vendor|artisan|composer\.(json|lock)|\.env)(/.*)?$ - [F,L]

    # /gesma tout court → /gesma/
    RewriteRule ^gesma$ /gesma/ [R=301,L]

    # Tout /gesma/<route> qui n'est pas un vrai fichier → gesma/index.php
    RewriteCond %{REQUEST_URI} ^/gesma/(.+)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^gesma/ gesma/index.php [L]
</IfModule>
