# .htaccess à placer dans le DOCROOT du domaine quand l'application est dans un sous-dossier.
# Exemple : le docroot est ~/htdocs/gesma.mobilier-addict.com/ et l'app est dans ./gesma/
# Installation : cp deploy/lws-docroot.htaccess ../.htaccess
# Puis définir APP_URL=https://gesma.mobilier-addict.com/gesma

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transférer l'en-tête Authorization et la clé API
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-API-KEY} .
    RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X_API_KEY}]

    # Fichiers statiques rangés dans gesma/public/
    RewriteRule ^gesma/((css|js|icons|logo|storage)/.+|sw\.js|manifest\.webmanifest|robots\.txt|favicon\.ico)$ gesma/public/$1 [L]

    # Bloquer les fichiers sensibles à l'intérieur de l'app
    RewriteRule ^gesma/\.(env|git|gitignore|gitattributes) - [F,L]
    RewriteRule ^gesma/(app|bootstrap|config|database|public|resources|routes|storage|tests|vendor|artisan|composer\.(json|lock)|README|phpunit)(/.*)?$ - [F,L]

    # /gesma tout court → /gesma/ (avec slash final)
    RewriteRule ^gesma$ gesma/ [R=301,L]

    # Tout /gesma/<route> non existant → gesma/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^gesma/(.*)$ gesma/index.php [L]
</IfModule>
