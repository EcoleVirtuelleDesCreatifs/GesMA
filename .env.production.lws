# Modèle de .env pour l'hébergement mutualisé LWS (Apache + MySQL, sans SSH).
# 1. Copier ce fichier en ".env" dans le dossier de l'application et compléter les valeurs.
# 2. Ouvrir https://votre-domaine/gesma/installation.php?token=<GESMA_INSTALL_TOKEN>
#    (génère APP_KEY, crée les tables, les magasins et les comptes).
# 3. Vider GESMA_INSTALL_TOKEN.
APP_NAME=GesMA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Adresse publique exacte, avec le sous-dossier s'il y en a un (sans / final).
APP_URL=https://gesma.mobilier-addict.com/gesma
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=error

# Base MySQL créée dans le panneau LWS (Bases de données MySQL).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Fichiers plutôt que base de données : l'application démarre même avant les migrations.
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
# Pas de worker permanent sur un mutualisé : les tâches s'exécutent immédiatement.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

GESMA_WEBSITE_API_KEY=
GESMA_WEBSITE_DEFAULT_STORE=YAM
GESMA_BACKUP_KEEP_DAYS=14

# Jeton de la page d'installation (au moins 16 caractères). À vider après l'installation.
GESMA_INSTALL_TOKEN=
