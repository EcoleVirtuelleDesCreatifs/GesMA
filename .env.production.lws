# Modèle de .env pour un hébergement mutualisé LWS (Apache + MySQL, sans SSH obligatoire).
# Copier ce fichier en ".env" sur le serveur, compléter les valeurs, puis ouvrir
# https://votre-domaine/installation.php?token=<GESMA_INSTALL_TOKEN> : la page génère APP_KEY,
# crée les tables et le compte direction. Vider GESMA_INSTALL_TOKEN ensuite.
APP_NAME=GesMA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_URL=https://gesma.mobilieraddict.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Base MySQL créée dans le panneau LWS (Bases de données MySQL).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Fichiers plutôt que base de données : l'application démarre même avant les migrations.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
# Pas de worker permanent sur un mutualisé : les tâches s'exécutent immédiatement.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Jeton de la page d'installation (au moins 16 caractères). À vider après l'installation.
GESMA_INSTALL_TOKEN=

GESMA_ADMIN_EMAIL=direction@mobilieraddict.ci
GESMA_ADMIN_PASSWORD=
