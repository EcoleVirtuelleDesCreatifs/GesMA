# .htaccess racine pour hébergement mutualisé (LWS, OVH, etc.)
# Utilisé quand le docroot pointe sur la racine du projet (index.php à la racine).
# Version sécurisée. En cas de 500 avec ce fichier, remplacez-le par deploy/htaccess-minimal.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transférer l'en-tête Authorization (API / authentification)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Bloquer l'accès direct aux fichiers/dossiers sensibles
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git.* - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|artisan|composer\.(json|lock)|package\.json|phpunit\.xml)(/.*)?$ - [F,L]

    # Tout le reste passe par le contrôleur frontal
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
