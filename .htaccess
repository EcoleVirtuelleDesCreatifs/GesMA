<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transférer l'en-tête d'autorisation et la clé API
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-API-KEY} .
    RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X-API-KEY}]

    # Ne jamais servir les fichiers/dossiers sensibles de la racine
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Tout le reste est servi depuis public/
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
